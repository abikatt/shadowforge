<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ShadowForge.Workbench"
        x:Class="ShadowForge.Workbench.MainWindow"
        Title="ShadowForge Workbench"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,260">
        <TextBlock Text="ShadowForge" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
        <TextBlock x:Name="RootText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                   Opacity="0.7" TextTrimming="CharacterEllipsis" />
        <Button x:Name="ChooseRootButton" Grid.Column="2" Content="Game folder…" Margin="0,0,8,0" />
        <TextBox x:Name="SearchBox" Grid.Column="3" PlaceholderText="Search" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <Button x:Name="ShowFolderButton" DockPanel.Dock="Right" Content="Show folder" IsVisible="False"
                Padding="8,2" FontSize="12" />
        <TextBlock x:Name="StatusText" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" TabStripPlacement="Left" Padding="12">
      <TabItem Header="Characters">
        <Grid ColumnDefinitions="*,12,520">
          <ListBox x:Name="CharacterList">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:CharacterRow">
                <Grid ColumnDefinitions="100,*,Auto">
                  <TextBlock Text="{Binding Id}" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" />
                    <TextBlock Text="{Binding ModelDef}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="tag"><TextBlock Text="{Binding Category}" FontSize="11" /></Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Column="2" Classes="panel">
            <Panel>
              <TextBlock x:Name="NoSelectionText" Text="Select a character to see its files and preview."
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
              <DockPanel x:Name="DetailsPanel" IsVisible="False">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                  <Border CornerRadius="6" ClipToBounds="True" Height="480" Background="#2A2A2C">
                    <Panel>
                      <local:ModelPreview x:Name="Preview" />
                      <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                 IsHitTestVisible="False" />
                      <ComboBox x:Name="ShadingBox" Classes="shading" />
                      <TextBlock x:Name="TextureStatus" Classes="textureStatus" />
                    </Panel>
                  </Border>
                  <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" Margin="0,-4,0,0"
                             FontSize="11" Opacity="0.45"
                             Text="Drag rotate · Right-drag pan · Scroll zoom · Double-click reset" />
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="DetailId" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace" />
                    <TextBlock x:Name="DetailRig" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,8,*">
                    <Button x:Name="OpenInBlenderButton" Content="Open in Blender" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="DeriveButton" Grid.Column="2" Content="Derive new…"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                  <TextBlock Text="Files" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl x:Name="FileList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:FileRow">
                        <StackPanel Margin="0,0,0,8" Opacity="{Binding Opacity}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#E0A040" />
                          </StackPanel>
                          <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas,monospace"
                                     TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Maps">
        <Grid ColumnDefinitions="*,12,520">
          <ListBox x:Name="MapList">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:MapRow">
                <Grid ColumnDefinitions="120,*,Auto">
                  <TextBlock Text="{Binding Id}" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="tag"><TextBlock Text="{Binding Category}" FontSize="11" /></Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Column="2" Classes="panel">
            <Panel>
              <TextBlock x:Name="NoMapText" Text="Select a stage to see its contents and preview."
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
              <DockPanel x:Name="MapDetailsPanel" IsVisible="False">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                  <Border CornerRadius="6" ClipToBounds="True" Height="480" Background="#2A2A2C">
                    <Panel>
                      <local:ModelPreview x:Name="MapPreview" />
                      <TextBlock x:Name="MapPreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                 IsHitTestVisible="False" />
                      <ComboBox x:Name="MapShadingBox" Classes="shading" />
                      <TextBlock x:Name="MapTextureStatus" Classes="textureStatus" />
                    </Panel>
                  </Border>
                  <TextBlock x:Name="MapPreviewHint" HorizontalAlignment="Center" Margin="0,-4,0,0"
                             FontSize="11" Opacity="0.45"
                             Text="Drag rotate · Right-drag pan · Scroll zoom · Double-click reset" />
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="MapDetailId" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace" />
                    <TextBlock x:Name="MapDetailInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,8,*">
                    <Button x:Name="OpenMapInBlenderButton" Content="Open in Blender" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="ExportMapButton" Grid.Column="2" Content="Export glTF"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                  <TextBlock Text="Contents" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl x:Name="StageEntryList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:StageEntryRow">
                        <StackPanel Margin="0,0,0,8">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.75" />
                          </StackPanel>
                          <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas,monospace"
                                     TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Mods">
        <Panel>
          <TextBlock x:Name="NoModsText" IsVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                     Text="Mods need a reblue install. This game folder is a loose extract, so it has no mods folder. Use Game folder… to choose the game folder of a reblue install." />
          <Grid x:Name="ModsContent" RowDefinitions="Auto,*" ColumnDefinitions="*,12,520">
            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
              <Button x:Name="AddModButton" DockPanel.Dock="Right" Content="Add mod folder…" />
              <Button x:Name="OpenModsFolderButton" DockPanel.Dock="Right" Content="Open mods folder"
                      Margin="0,0,8,0" />
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ModOrderText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ModOrderWarning" FontSize="12" Foreground="#E0A040" IsVisible="False"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <ListBox x:Name="ModList" Grid.Row="1">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ModRow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                              ToolTip.Tip="Enable or disable in mod_order.txt" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="tag" IsVisible="{Binding Missing}">
                      <TextBlock Text="missing" FontSize="11" Foreground="#E0A040" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Grid.Column="2" Classes="panel">
              <Panel>
                <TextBlock x:Name="NoModSelectionText" Text="Select a mod to see its details and files."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
                <DockPanel x:Name="ModDetailsPanel" IsVisible="False">
                  <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="ModDetailTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="ModDetailByline" FontSize="12" Opacity="0.7" />
                      <TextBlock x:Name="ModDetailOrder" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock x:Name="ModDetailDescription" TextWrapping="Wrap" />
                    <Button x:Name="OpenModFolderButton" Content="Open folder" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ModFilesHeader" FontWeight="SemiBold" Margin="0,6,0,0" />
                  </StackPanel>
                  <ScrollViewer>
                    <ItemsControl x:Name="ModFileList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ModFileRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas,monospace"
                                       TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="11" Opacity="0.6"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Panel>
            </Border>
          </Grid>
        </Panel>
      </TabItem>
    </TabControl>
  </DockPanel>

  <Window.Styles>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.shading">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip.Tip" Value="Preview shading" />
    </Style>
    <Style Selector="TextBlock.textureStatus">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="10,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Styles>
</Window>
