<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ShadowForge.Workbench"
        x:Class="ShadowForge.Workbench.MainWindow"
        Title="ShadowForge Workbench"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,260">
        <TextBlock Text="ShadowForge" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
        <TextBlock x:Name="RootText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                   Opacity="0.7" TextTrimming="CharacterEllipsis" />
        <Button x:Name="ChooseRootButton" Grid.Column="2" Content="Game folder…" Margin="0,0,8,0" />
        <TextBox x:Name="SearchBox" Grid.Column="3" PlaceholderText="Search" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <Button x:Name="ShowFolderButton" DockPanel.Dock="Right" Content="Show folder" IsVisible="False"
                Padding="8,2" FontSize="12" />
        <TextBlock x:Name="StatusText" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" TabStripPlacement="Left" Padding="12">
      <TabItem Header="Characters">
        <Grid ColumnDefinitions="*,12,520">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Classes="listTools">
              <TextBlock x:Name="CharacterCount" DockPanel.Dock="Right" Classes="listCount" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Sort" Classes="toolLabel" />
                <ComboBox x:Name="CharacterSortBox" MinWidth="130" />
                <TextBlock Text="Class" Classes="toolLabel" Margin="8,0,0,0" />
                <ComboBox x:Name="CharacterClassBox" MinWidth="130" />
                <CheckBox x:Name="CharacterNamedOnly" Content="Named only" Margin="8,0,0,0"
                          ToolTip.Tip="Hide ids the game gives no name" />
              </StackPanel>
            </DockPanel>
            <ListBox x:Name="CharacterList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:CharacterRow">
                  <Grid ColumnDefinitions="100,*,Auto">
                    <TextBlock Text="{Binding Id}" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Text="{Binding ModelDef}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="tag"><TextBlock Text="{Binding Class}" FontSize="11" /></Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Column="2" Classes="panel">
            <Panel>
              <TextBlock x:Name="NoSelectionText" Text="Select a character to see its files and preview."
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
              <DockPanel x:Name="DetailsPanel" IsVisible="False">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                  <Border CornerRadius="6" ClipToBounds="True" Height="480" Background="#2A2A2C">
                    <Panel>
                      <local:ModelPreview x:Name="Preview" />
                      <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                 IsHitTestVisible="False" />
                      <ComboBox x:Name="ShadingBox" Classes="shading" />
                      <TextBlock x:Name="TextureStatus" Classes="textureStatus" />
                    </Panel>
                  </Border>
                  <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" Margin="0,-4,0,0"
                             FontSize="11" Opacity="0.45"
                             Text="Drag rotate · Right-drag pan · Scroll zoom · Double-click reset" />
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="DetailId" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace" />
                    <TextBlock x:Name="DetailRig" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,8,*">
                    <Button x:Name="OpenInBlenderButton" Content="Open in Blender" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="DeriveButton" Grid.Column="2" Content="Derive new…"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                  <Button x:Name="DeployEditButton" Content="Deploy edit as mod…" Margin="0,-4,0,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          ToolTip.Tip="Cook an edited .glb of this character back into game files and write them as a mod" />
                  <Grid ColumnDefinitions="*,8,Auto,8,*" Margin="0,-4,0,0">
                    <Button x:Name="ExportTexturesButton" Content="Export textures"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Save this character's textures as PNGs in your textures folder, keeping any already there" />
                    <Button x:Name="OpenTexturesButton" Grid.Column="2" Content="Open folder"
                            ToolTip.Tip="Open this character's folder of exported textures" />
                    <Button x:Name="DeployTexturesButton" Grid.Column="4" Content="Deploy textures as mod…"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Convert the PNGs you changed back into textures and write them as a mod" />
                  </Grid>
                  <TextBlock Text="Files" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl x:Name="FileList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:FileRow">
                        <StackPanel Margin="0,0,0,8" Opacity="{Binding Opacity}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#E0A040" />
                          </StackPanel>
                          <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas,monospace"
                                     TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Maps">
        <Grid ColumnDefinitions="*,12,520">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Classes="listTools">
              <TextBlock x:Name="MapCount" DockPanel.Dock="Right" Classes="listCount" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Sort" Classes="toolLabel" />
                <ComboBox x:Name="MapSortBox" MinWidth="130" />
                <TextBlock Text="Category" Classes="toolLabel" Margin="8,0,0,0" />
                <ComboBox x:Name="MapCategoryBox" MinWidth="130" />
                <CheckBox x:Name="MapNamedOnly" Content="Named only" Margin="8,0,0,0"
                          ToolTip.Tip="Hide stages the game gives no name" />
                <CheckBox x:Name="MapAvailableOnly" Content="Available only"
                          ToolTip.Tip="Hide stages whose region pack is missing" />
              </StackPanel>
            </DockPanel>
            <ListBox x:Name="MapList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:MapRow">
                  <Grid ColumnDefinitions="120,*,Auto">
                    <TextBlock Text="{Binding Id}" FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="tag"><TextBlock Text="{Binding Category}" FontSize="11" /></Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Column="2" Classes="panel">
            <Panel>
              <TextBlock x:Name="NoMapText" Text="Select a stage to see its contents and preview."
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
              <DockPanel x:Name="MapDetailsPanel" IsVisible="False">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                  <Border CornerRadius="6" ClipToBounds="True" Height="480" Background="#2A2A2C">
                    <Panel>
                      <local:ModelPreview x:Name="MapPreview" />
                      <TextBlock x:Name="MapPreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                 IsHitTestVisible="False" />
                      <ComboBox x:Name="MapShadingBox" Classes="shading" />
                      <TextBlock x:Name="MapTextureStatus" Classes="textureStatus" />
                    </Panel>
                  </Border>
                  <TextBlock x:Name="MapPreviewHint" HorizontalAlignment="Center" Margin="0,-4,0,0"
                             FontSize="11" Opacity="0.45"
                             Text="Drag rotate · Right-drag pan · Scroll zoom · Double-click reset" />
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="MapDetailId" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace" />
                    <TextBlock x:Name="MapDetailInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,8,*">
                    <Button x:Name="OpenMapInBlenderButton" Content="Open in Blender" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="ExportMapButton" Grid.Column="2" Content="Export glTF"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                </StackPanel>
                <ScrollViewer>
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="ScriptsHeader" Text="Scene scripts" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <StackPanel x:Name="ScriptModRow" Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Build into mod" Classes="toolLabel" />
                      <TextBox x:Name="ScriptModName" MinWidth="160" />
                      <CheckBox x:Name="ScriptEnableOnBuild" Content="Enable after building" />
                    </StackPanel>
                    <ItemsControl x:Name="ScriptList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ScriptRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding FileName}" FontFamily="Consolas,monospace" FontSize="12" />
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#E0A040" />
                              </StackPanel>
                              <TextBlock Text="{Binding SceneName}" FontSize="11" Opacity="0.6"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Button Classes="scriptEdit" Content="Edit" Padding="10,3" FontSize="12"
                                      ToolTip.Tip="Decompile to your scripts folder and open it in your text editor" />
                              <Button Classes="scriptBuild" Content="Build" Padding="10,3" FontSize="12"
                                      ToolTip.Tip="Compile your edited copy into the mod above" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Contents" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <ItemsControl x:Name="StageEntryList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:StageEntryRow">
                          <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                            <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas,monospace"
                                       TextWrapping="Wrap" Opacity="0.75" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Mods">
        <Panel>
          <TextBlock x:Name="NoModsText" IsVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                     TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                     Text="Mods need a reblue install. This game folder is a loose extract, so it has no mods folder. Use Game folder… to choose the game folder of a reblue install." />
          <Grid x:Name="ModsContent" RowDefinitions="Auto,*" ColumnDefinitions="*,12,520">
            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
              <Button x:Name="AddModButton" DockPanel.Dock="Right" Content="Add mod folder…" />
              <Button x:Name="BuildModButton" DockPanel.Dock="Right" Content="Build mod from source…" Margin="0,0,8,0"
                      ToolTip.Tip="Build a mod from a source folder: a mod .toml plus entities\&lt;id&gt;\entity.toml" />
              <Button x:Name="OpenModsFolderButton" DockPanel.Dock="Right" Content="Open mods folder"
                      Margin="0,0,8,0" />
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ModOrderText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ModOrderWarning" FontSize="12" Foreground="#E0A040" IsVisible="False"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <ListBox x:Name="ModList" Grid.Row="1">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ModRow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                              ToolTip.Tip="Enable or disable in mod_order.txt" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="tag" IsVisible="{Binding Missing}">
                      <TextBlock Text="missing" FontSize="11" Foreground="#E0A040" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Grid.Column="2" Classes="panel">
              <Panel>
                <TextBlock x:Name="NoModSelectionText" Text="Select a mod to see its details and files."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
                <DockPanel x:Name="ModDetailsPanel" IsVisible="False">
                  <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="ModDetailTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="ModDetailByline" FontSize="12" Opacity="0.7" />
                      <TextBlock x:Name="ModDetailOrder" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock x:Name="ModDetailDescription" TextWrapping="Wrap" />
                    <Button x:Name="OpenModFolderButton" Content="Open folder" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ModFilesHeader" FontWeight="SemiBold" Margin="0,6,0,0" />
                  </StackPanel>
                  <ScrollViewer>
                    <ItemsControl x:Name="ModFileList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ModFileRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="Consolas,monospace"
                                       TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="11" Opacity="0.6"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Panel>
            </Border>
          </Grid>
        </Panel>
      </TabItem>

      <TabItem Header="Audio">
        <Grid ColumnDefinitions="*,12,560">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Classes="listTools">
              <TextBlock x:Name="BankCount" DockPanel.Dock="Right" Classes="listCount" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Folder" Classes="toolLabel" />
                <ComboBox x:Name="BankFolderBox" MinWidth="170" />
              </StackPanel>
            </DockPanel>
            <ListBox x:Name="BankList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:BankRow">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontFamily="Consolas,monospace" />
                      <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="tag"><TextBlock Text="{Binding Kind}" FontSize="11" /></Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Column="2" Classes="panel">
            <Panel>
              <TextBlock x:Name="NoBankText" Text="Select a sound bank to hear, export or replace its waves."
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="24" />
              <DockPanel x:Name="BankDetailsPanel" IsVisible="False">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="BankTitle" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace" />
                    <TextBlock x:Name="BankInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,8,*">
                    <Button x:Name="StopAudioButton" Content="Stop playback"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button x:Name="ExportBankButton" Grid.Column="2" Content="Export all as .wav"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Save replacements as" Classes="toolLabel" />
                    <RadioButton x:Name="AudioSaveLossless" GroupName="AudioSaveFormat" Content="Lossless (PCM)"
                                 ToolTip.Tip="Keep replacements as 16-bit PCM .wav. Building the mod encodes them to XMA." />
                    <RadioButton x:Name="AudioSaveXma" GroupName="AudioSaveFormat" Content="Lossy (XMA)"
                                 ToolTip.ShowOnDisabled="True" />
                  </StackPanel>
                  <DockPanel>
                    <Button x:Name="BuildBankButton" DockPanel.Dock="Right" Content="Build into mod" Margin="8,0,0,0"
                            ToolTip.ShowOnDisabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Mod" Classes="toolLabel" />
                      <TextBox x:Name="AudioModName" MinWidth="160" />
                      <CheckBox x:Name="AudioEnableOnBuild" Content="Enable after building" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock x:Name="WavesHeader" Text="Waves" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <ScrollViewer>
                  <ItemsControl x:Name="WaveList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:WaveRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                          <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Title}" FontFamily="Consolas,monospace" FontSize="12" />
                              <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#E0A040" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="wavePlay" Content="Play" Padding="10,3" FontSize="12" />
                            <Button Classes="waveExport" Content="Export" Padding="10,3" FontSize="12" />
                            <Button Classes="waveReplace" Content="Replace…" Padding="10,3" FontSize="12"
                                    ToolTip.Tip="Save an audio file as this wave's replacement. Build into mod puts it in the game." />
                            <Button Classes="waveRevert" Content="Revert" Padding="10,3" FontSize="12"
                                    IsVisible="{Binding IsReplaced}"
                                    ToolTip.Tip="Delete this wave's replacement. Build into mod again to update the mod." />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="26" Margin="4,0,24,24">

            <StackPanel Spacing="14">
              <TextBlock Classes="settingsHeader" Text="Game" />
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Game folder" />
                <TextBlock Classes="settingHelp"
                           Text="The Blue Dragon game-data folder. Detecting uses SHADOWFORGE_GAME_ROOT, then the reblue install." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsChooseRootButton" Content="Choose…" />
                    <Button x:Name="SettingsDetectRootButton" Content="Detect automatically" />
                  </StackPanel>
                  <TextBox x:Name="SettingsGameRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Name language" />
                <TextBlock Classes="settingHelp"
                           Text="Which of the game's name tables labels characters and stages." />
                <ComboBox x:Name="SettingsLanguageBox" MinWidth="200" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="settingsHeader" Text="Tools" />
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Blender" />
                <TextBlock Classes="settingHelp"
                           Text="The blender.exe that Open in Blender starts. It needs the ShadowForge extension installed." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseBlenderButton" Content="Browse…" />
                    <Button x:Name="SettingsDetectBlenderButton" Content="Detect" />
                  </StackPanel>
                  <TextBox x:Name="SettingsBlenderPath" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="FFmpeg" />
                <TextBlock Classes="settingHelp"
                           Text="Almost all of the game's audio is XMA, which the Audio tab decodes and converts through ffmpeg.exe. Without it, only the few PCM waves play, and replacements must be 16-bit PCM .wav files." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseFfmpegButton" Content="Browse…" />
                    <Button x:Name="SettingsDetectFfmpegButton" Content="Detect" />
                  </StackPanel>
                  <TextBox x:Name="SettingsFfmpegPath" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="XMA encoder" />
                <TextBlock Classes="settingHelp"
                           Text="xmaencode.exe from the Xbox 360 SDK encodes replacement audio to XMA, the format the game's banks use. It is Microsoft's and cannot be bundled with ShadowForge. Without it, replacements can only be saved as lossless .wav and cannot be built into a mod." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseXmaButton" Content="Browse…" />
                    <Button x:Name="SettingsDetectXmaButton" Content="Detect" />
                  </StackPanel>
                  <TextBox x:Name="SettingsXmaPath" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="settingsHeader" Text="Output" />
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Derived characters" />
                <TextBlock Classes="settingHelp" Text="Derive new… writes each new character to a folder here." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseDerivedButton" Content="Browse…" />
                    <Button x:Name="SettingsOpenDerivedButton" Content="Open" />
                  </StackPanel>
                  <TextBox x:Name="SettingsDerivedRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Map exports" />
                <TextBlock Classes="settingHelp" Text="Export glTF writes each stage to a folder here." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseMapExportButton" Content="Browse…" />
                    <Button x:Name="SettingsOpenMapExportButton" Content="Open" />
                  </StackPanel>
                  <TextBox x:Name="SettingsMapExportRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Scene scripts" />
                <TextBlock Classes="settingHelp"
                           Text="Edit keeps each scene script here as text, in the game's own folder layout. Your edits stay here until you delete them." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseScriptsButton" Content="Browse…" />
                    <Button x:Name="SettingsOpenScriptsButton" Content="Open" />
                  </StackPanel>
                  <TextBox x:Name="SettingsScriptRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Textures" />
                <TextBlock Classes="settingHelp"
                           Text="Export textures saves each character's textures here as PNGs, one folder per character, for editing." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseTexturesButton" Content="Browse…" />
                    <Button x:Name="SettingsOpenTexturesButton" Content="Open" />
                  </StackPanel>
                  <TextBox x:Name="SettingsTextureRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Audio exports" />
                <TextBlock Classes="settingHelp" Text="Export saves waves here as .wav, one folder per bank." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseAudioButton" Content="Browse…" />
                    <Button x:Name="SettingsOpenAudioButton" Content="Open" />
                  </StackPanel>
                  <TextBox x:Name="SettingsAudioRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Audio replacements" />
                <TextBlock Classes="settingHelp" Text="Replace saves waves here, as .wav or .xma, until Build into mod puts them in the game." />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button x:Name="SettingsBrowseAudioWorkButton" Content="Browse…" />
                    <Button x:Name="SettingsOpenAudioWorkButton" Content="Open" />
                  </StackPanel>
                  <TextBox x:Name="SettingsAudioWorkRoot" IsReadOnly="True" />
                </DockPanel>
              </StackPanel>
              <CheckBox x:Name="SettingsExportTextures" Content="Include textures in map exports" />
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="settingsHeader" Text="Preview" />
              <StackPanel Classes="setting">
                <TextBlock Classes="settingName" Text="Texture quality" />
                <TextBlock Classes="settingHelp"
                           Text="The size textures are scaled to in the textured previews. Higher is sharper but slower to load and uses more memory on large stages." />
                <ComboBox x:Name="SettingsTextureQualityBox" MinWidth="200" />
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>

  <Window.Styles>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.settingsHeader">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.setting">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.settingName">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.settingHelp">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="DockPanel.listTools">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.toolLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.listCount">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="ComboBox.shading">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip.Tip" Value="Preview shading" />
    </Style>
    <Style Selector="TextBlock.textureStatus">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="10,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Styles>
</Window>
