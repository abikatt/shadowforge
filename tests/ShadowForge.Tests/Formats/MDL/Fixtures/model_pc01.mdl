//	p-bone(M) 髪の毛
CLOTH T_HAIR_S {
	BONE {
		NODE "hair_ra"
		NODE "hair_rb"
		NODE "hair_rc"
		NODE "hair_rd"
		NODE "hair_re"
		NODE "hair_rf"
		NODE "hair_rg"
		NODE "hair_rh"
		NODE "hair_la"
		NODE "hair_lb"
		NODE "hair_lc"
		NODE "hair_ld"
		NODE "hair_le"
		NODE "hair_lf"
		NODE "hair_lg"
		NODE "hair_b"
	}
}

//	p-bone(L) 腰の布
CLOTH T_CLOTH_L {
	BONE {
		NODE "cloth_f"
		NODE "cloth_b"
	}
	COLLI {
		CYL "rightupleg" -0.671,0.087,0.042, 90.270,-78.312,179.308, 0.800,2.706,0.800	// PBcylShape2
	}
	COLLISIZE 1.4				// コリジョン半径40%増しで
	IGNOREMOTCHECK				// モーションチェックを無視
}

