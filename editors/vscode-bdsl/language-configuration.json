{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\{\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*\\};?"
  },
  "wordPattern": "@\\d+|0[xX][0-9A-Fa-f]+|-?\\d*\\.\\d+(?:[eE][-+]?\\d+)?|-?\\d+|[A-Za-z_][A-Za-z0-9_]*"
}
